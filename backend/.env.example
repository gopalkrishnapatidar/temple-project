SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/temple_platform_dev
SPRING_DATASOURCE_USERNAME=temple_app
SPRING_DATASOURCE_PASSWORD=CHANGE_ME
# Optional: separate Flyway/DDL role. Defaults to the datasource user.
# SPRING_FLYWAY_USERNAME=temple_migrator
# SPRING_FLYWAY_PASSWORD=CHANGE_ME
HIKARI_MAXIMUM_POOL_SIZE=10
HIKARI_MINIMUM_IDLE=2
# HMAC-SHA256 signing secret; must be at least 32 bytes. Never commit a real secret.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE_AT_LEAST_32_BYTES
JWT_ISSUER=temple-platform
JWT_ACCESS_TOKEN_TTL=15m
CACHE_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TIMEOUT=200ms
# REDIS_PASSWORD=
# HMAC secret for mock payment webhook signature verification (local dev only).
MOCK_PAYMENT_WEBHOOK_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE_AT_LEAST_32_BYTES
